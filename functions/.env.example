# Cloud Function environment (functions/.env.user or Firebase Console)
# Used by the AI module. At least one provider key unlocks aiAnalyze.

# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
AI_PROVIDER=openai   # openai | gemini | rules

# Reorder forecasting baseline (units of safety stock to keep)
FORECAST_SAFETY_FACTOR=1.5