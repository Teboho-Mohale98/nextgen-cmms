rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Any authenticated user may upload profile & photo-annotation files.
    // Attachments are namespaced by uid/app so no one can touch another
    // tenant's blobs accidentally.
    match /attachments/{appId}/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}